# Example backend config for the dev environment.
# Copy to backend.hcl, replace the Cloudflare account ID, and provide R2
# credentials through AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.

bucket = "omscs-hub-terraform-state"
key    = "dev/terraform.tfstate"
region = "auto"

endpoints = {
  s3 = "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
}

use_lockfile = true

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
